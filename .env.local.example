# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings — Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER expose to client bundles or commit.
# Used only by app/auth/callback/route.ts to create a user's first profile row
# (bypasses RLS, since a brand-new user has no row yet to satisfy a self-scoped policy).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build the OAuth redirect target (must end with /auth/callback
# once combined). Use http://localhost:3000 in dev, your real domain in production.
# Must also be registered as an allowed redirect URL in Supabase Auth settings and
# in the Azure AD app registration's redirect URI configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
