# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings — Supabase Dashboard > Project Settings > API Keys.
# Uses Supabase's current key format (publishable/secret), not the legacy anon/service_role
# names — same underlying credentials, just the modern key pair Supabase now issues by default.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Secret key — server-only, NEVER expose to client bundles or commit.
# Used only by app/auth/callback/route.ts and lib/supabase/admin.ts to create a user's first
# persons/user_accounts rows (bypasses RLS, since a brand-new user has no row yet to satisfy a
# self-scoped policy) and by the admin Auth API calls for password-based accounts.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Base URL used to build the OAuth redirect target (must end with /auth/callback
# once combined). Use http://localhost:3000 in dev, your real domain in production.
# Must also be registered as an allowed redirect URL in Supabase Auth settings and
# in the Azure AD app registration's redirect URI configuration. Also used to build the
# invite email's login link (lib/email/invite.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Microsoft Graph — sends invite/onboarding emails via a dedicated Azure AD app registration
# (application permission Mail.Send, admin-consented, ideally scoped to MS_GRAPH_SENDER_EMAIL
# via an Exchange Online application access policy). See 05-setup-runbook.md for the full setup.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=your-app-registration-client-id
MS_GRAPH_CLIENT_SECRET=your-app-registration-client-secret
MS_GRAPH_SENDER_EMAIL=no-reply@yourdomain.com
MS_GRAPH_SENDER_NAME=Fauji Foods Employee Portal
